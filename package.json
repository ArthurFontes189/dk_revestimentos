{
  "name": "dk-revestimentos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev:site": "pnpm --filter @dk/site dev",
    "dev:admin": "pnpm --filter @dk/admin dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "build:e2e": "node scripts/build-e2e.mjs",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present build && node scripts/montar-dist.mjs",
    "importar:portfolio": "node --env-file=.env scripts/importar-portfolio.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
