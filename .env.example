# Copie para .env e preencha. NUNCA commite o .env.
# Tudo aqui com prefixo PUBLIC_ / VITE_ vai para o navegador: só coloque valores públicos.

# --- Supabase (projeto NOVO da v2; chave publishable = pública por desenho, protegida por RLS) ---
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Site ---
# URL final do site, sem barra no fim (ex.: https://usuario.github.io)
SITE_URL=http://localhost:4321
# Caminho base. "/" com domínio próprio; "/nome-do-repo/" em GitHub Pages de projeto. Termina com "/".
BASE_PATH=/
# WhatsApp só com dígitos, com DDI e DDD (valor fictício até o cliente informar o real)
PUBLIC_WHATSAPP_NUMBER=5561900000000
VITE_WHATSAPP_NUMBER=5561900000000

# --- Meta Pixel (vazio = desligado) ---
PUBLIC_META_PIXEL_ID=

# --- Segredos: NÃO vão para o navegador. Configure no Supabase (Edge Functions), nunca neste arquivo no repositório. ---
# META_CAPI_ACCESS_TOKEN=
