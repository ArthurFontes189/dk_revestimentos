---
import { linkWhatsApp } from '../lib/contato';

const itens = [
  { href: '#servicos', rotulo: 'Serviços' },
  { href: '#portfolio', rotulo: 'Portfólio' },
  { href: '#processo', rotulo: 'Como trabalhamos' },
  { href: '#orcamento', rotulo: 'Orçamento' },
];
const whatsapp = linkWhatsApp('Olá! Gostaria de pedir um orçamento.');
---

<header class="bg-ebano-950/95 text-creme sticky top-0 z-30 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a
      href="#inicio"
      class="font-(family-name:--font-display) text-lg"
      aria-label="DK Revestimentos, início"
    >
      DK <span class="text-ouro-500">Revestimentos</span>
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 md:flex">
      {itens.map((item) => (
        <a
          href={item.href}
          class="text-ebano-100 hover:text-ouro-500 focus-visible:outline-ouro-500 inline-flex min-h-11 items-center rounded-lg px-3 text-sm transition-colors focus-visible:outline-2"
        >
          {item.rotulo}
        </a>
      ))}
      <a
        href={whatsapp}
        class="bg-carvalho-600 hover:bg-carvalho-700 focus-visible:outline-ouro-500 ml-2 inline-flex min-h-11 items-center rounded-lg px-4 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        WhatsApp
      </a>
    </nav>

    <!-- Celular: menu sem JavaScript -->
    <details class="relative md:hidden">
      <summary class="focus-visible:outline-ouro-500 inline-flex min-h-11 cursor-pointer list-none items-center rounded-lg px-3 text-sm focus-visible:outline-2">
        Menu
      </summary>
      <nav
        aria-label="Principal (celular)"
        class="bg-ebano-900 absolute right-0 mt-2 flex w-56 flex-col rounded-lg p-2 shadow-lg"
      >
        {itens.map((item) => (
          <a
            href={item.href}
            class="hover:bg-ebano-800 inline-flex min-h-11 items-center rounded-lg px-3"
          >
            {item.rotulo}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
