---
import { rastreioConfigurado } from '../lib/rastreio';
import { url } from '../lib/urls';

const classeBotao =
  'border-ouro-500 text-ouro-500 hover:bg-ouro-500 hover:text-ebano-950 focus-visible:outline-ouro-500 inline-flex min-h-11 flex-1 items-center justify-center rounded-lg border px-5 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 sm:w-32 sm:flex-none';
---

{rastreioConfigurado && (
  <section
    id="banner-cookies"
    hidden
    aria-label="Preferências de cookies"
    class="fixed inset-x-0 bottom-0 z-40 p-4"
  >
    <div class="border-ebano-600 bg-ebano-900 text-creme mx-auto max-w-3xl rounded-xl border p-4 shadow-xl sm:flex sm:items-center sm:gap-6">
      <p class="text-sm leading-relaxed">
        Usamos cookies de medição e anúncios (Meta) para entender o que traz clientes ao site. Só os
        ativamos se você aceitar.
        <a href={url('privacidade/')} class="text-ouro-500 underline">
          Política de privacidade
        </a>
      </p>
      {/* Mesmo peso visual nas duas opções: recusar é tão fácil quanto aceitar. */}
      <div class="mt-3 flex gap-2 sm:mt-0 sm:shrink-0">
        <button type="button" data-cookies="recusado" class={classeBotao}>
          Recusar
        </button>
        <button type="button" data-cookies="aceito" class={classeBotao}>
          Aceitar
        </button>
      </div>
    </div>
  </section>
)}

<script>
  import { lerEscolha, rastreioConfigurado, salvarEscolha, type Escolha } from '../lib/rastreio';

  const banner = document.getElementById('banner-cookies');
  if (banner && rastreioConfigurado) {
    if (lerEscolha() === null) banner.hidden = false;

    banner.querySelectorAll<HTMLButtonElement>('[data-cookies]').forEach((botao) => {
      botao.addEventListener('click', () => {
        salvarEscolha(botao.dataset.cookies as Escolha);
        banner.hidden = true;
      });
    });

    // Botão "Preferências de cookies" do rodapé reabre o banner.
    document.querySelectorAll('[data-abrir-cookies]').forEach((botao) => {
      botao.addEventListener('click', () => {
        banner.hidden = false;
      });
    });
  }
</script>
