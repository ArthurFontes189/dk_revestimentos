---
import { linkWhatsApp } from '../lib/contato';
import { rastreioConfigurado } from '../lib/rastreio';
import { url } from '../lib/urls';

interface Props {
  /** Reserva espaço para a barra fixa do celular (só a home tem essa barra). */
  comBarraCta?: boolean;
}

const { comBarraCta = false } = Astro.props;
const whatsapp = linkWhatsApp('Olá! Gostaria de pedir um orçamento.');
const ano = new Date().getFullYear();
const classeLink =
  'text-ebano-100 hover:text-ouro-500 focus-visible:outline-ouro-500 inline-flex min-h-11 items-center text-sm underline focus-visible:outline-2';
---

<footer
  class:list={['bg-ebano-950 text-ebano-100 px-4 pt-14', comBarraCta ? 'pb-28 md:pb-14' : 'pb-14']}
>
  <div class="mx-auto flex max-w-6xl flex-col gap-8 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-creme font-(family-name:--font-display) text-2xl">
        DK <span class="text-ouro-500">Revestimentos</span>
      </p>
      <p class="mt-2 max-w-sm">Marcenaria e revestimentos sob medida.</p>
    </div>
    <div class="flex flex-col gap-1 md:items-end">
      <a
        href={whatsapp}
        class="text-ouro-500 focus-visible:outline-ouro-500 inline-flex min-h-11 items-center underline focus-visible:outline-2"
      >
        Falar no WhatsApp
      </a>
      <nav aria-label="Informações legais" class="flex flex-wrap gap-x-5 md:justify-end">
        <a href={url('privacidade/')} class={classeLink}>
          Política de privacidade
        </a>
        {rastreioConfigurado && (
          <button type="button" data-abrir-cookies class={classeLink}>
            Preferências de cookies
          </button>
        )}
      </nav>
      <p class="text-ebano-300 text-sm">© {ano} DK Revestimentos</p>
    </div>
  </div>
</footer>
