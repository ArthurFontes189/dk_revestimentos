---
import { linkWhatsApp } from '../lib/contato';

const whatsapp = linkWhatsApp('Olá! Gostaria de pedir um orçamento.');
---

<!-- Celular: barra fixa com as duas ações de conversão. Some quando o formulário está na tela. -->
<div
  id="barra-cta"
  class="bg-ebano-950/95 fixed inset-x-0 bottom-0 z-20 flex gap-2 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur transition-transform md:hidden"
>
  <a
    href="#orcamento"
    class="bg-carvalho-600 text-creme hover:bg-carvalho-700 focus-visible:outline-ouro-500 inline-flex min-h-11 flex-1 items-center justify-center rounded-lg px-4 font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    Pedir orçamento
  </a>
  <a
    href={whatsapp}
    class="border-ouro-500 text-ouro-500 focus-visible:outline-ouro-500 inline-flex min-h-11 items-center justify-center rounded-lg border px-4 font-medium focus-visible:outline-2 focus-visible:outline-offset-2"
  >
    WhatsApp
  </a>
</div>

<script>
  const barra = document.getElementById('barra-cta');
  const alvos = ['hero', 'orcamento']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (barra && alvos.length > 0 && 'IntersectionObserver' in window) {
    // A barra fica escondida enquanto o topo ou o formulário (que já têm os mesmos botões) estão na tela.
    const naTela = new Set<Element>();
    const observador = new IntersectionObserver((entradas) => {
      for (const entrada of entradas) {
        if (entrada.isIntersecting) naTela.add(entrada.target);
        else naTela.delete(entrada.target);
      }
      const esconder = naTela.size > 0;
      barra.classList.toggle('translate-y-full', esconder);
      // Escondida, a barra não deve receber foco nem toque.
      barra.toggleAttribute('inert', esconder);
    });
    alvos.forEach((alvo) => observador.observe(alvo));
  }
</script>
