---
import { Image } from 'astro:assets';
import deckLago from '../assets/portfolio/deck-lago.jpg';
import BarraCta from '../components/BarraCta.astro';
import Cabecalho from '../components/Cabecalho.astro';
import FormularioOrcamento from '../components/FormularioOrcamento';
import Portfolio from '../components/Portfolio.astro';
import Processo from '../components/Processo.astro';
import Rodape from '../components/Rodape.astro';
import Servicos from '../components/Servicos.astro';
import Base from '../layouts/Base.astro';
import { linkWhatsApp, NUMERO_WHATSAPP } from '../lib/contato';

const whatsapp = linkWhatsApp('Olá! Gostaria de pedir um orçamento.');
---

<Base
  title="DK Revestimentos | Marcenaria e revestimentos sob medida"
  description="Marcenaria e revestimentos sob medida: móveis, decks, painéis e ambientes completos em madeira. Peça seu orçamento pelo WhatsApp."
>
  <Cabecalho />

  <main id="inicio">
    <section id="hero" class="bg-ebano-950 text-creme px-4 py-14 md:py-20">
      <div class="mx-auto grid max-w-6xl items-center gap-10 md:grid-cols-2 lg:gap-16">
        <div>
          <p class="text-ouro-500 text-sm tracking-[0.2em] uppercase">
            Marcenaria e revestimentos sob medida
          </p>
          <h1 class="mt-4 text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">
            Madeira trabalhada sob medida para o seu espaço
          </h1>
          <p class="text-ebano-100 mt-6 max-w-xl text-lg leading-relaxed">
            Móveis, decks, painéis e revestimentos desenhados para cada ambiente, da conversa
            inicial à montagem.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="#orcamento"
              class="bg-carvalho-600 text-creme hover:bg-carvalho-700 focus-visible:outline-ouro-500 inline-flex min-h-12 items-center justify-center rounded-lg px-7 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              Pedir orçamento
            </a>
            <a
              href={whatsapp}
              class="border-ouro-500 text-ouro-500 hover:bg-ouro-500 hover:text-ebano-950 focus-visible:outline-ouro-500 inline-flex min-h-12 items-center justify-center rounded-lg border px-7 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              Falar no WhatsApp
            </a>
          </div>
        </div>

        <Image
          src={deckLago}
          alt="Deck de madeira em curva à beira de um lago, com bancos e guarda-corpo em madeira."
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          format="webp"
          quality={78}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full rounded-2xl object-cover"
        />
      </div>
    </section>

    <Servicos />
    <Portfolio />
    <Processo />

    <section id="orcamento" class="bg-carvalho-50 scroll-mt-16 px-4 py-20">
      <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-2 md:items-start lg:gap-16">
        <div>
          <p class="text-carvalho-700 text-sm tracking-[0.2em] uppercase">Orçamento</p>
          <h2 class="mt-3 text-3xl sm:text-4xl">Conte o que você precisa</h2>
          <p class="text-texto-suave mt-4 max-w-md text-lg leading-relaxed">
            Preencha em menos de um minuto e retornamos pelo WhatsApp. Se preferir, chame direto.
          </p>
          <a
            href={whatsapp}
            class="text-carvalho-700 focus-visible:outline-carvalho-600 mt-6 inline-flex min-h-11 items-center underline focus-visible:outline-2"
          >
            Prefiro falar no WhatsApp
          </a>
        </div>
        <div class="border-ebano-200 rounded-2xl border bg-white p-6 shadow-sm sm:p-8">
          <FormularioOrcamento client:visible numeroWhatsApp={NUMERO_WHATSAPP} />
        </div>
      </div>
    </section>
  </main>

  <Rodape />
  <BarraCta />
</Base>
